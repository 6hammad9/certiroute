# Copy this file to .env and replace the placeholder locally.
# Never commit .env or a real credential.
FORTYGUARD_API_KEY=replace_with_your_key
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com/v1

# Optional client safeguards
# FORTYGUARD_TIMEOUT_SECONDS=30
# FORTYGUARD_POLL_INTERVAL_SECONDS=5
# FORTYGUARD_MAX_POLL_ATTEMPTS=60
